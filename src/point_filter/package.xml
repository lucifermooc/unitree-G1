<?xml version="1.0"?>
<package format="3">
  <name>point_filter</name>
  <version>0.1.0</version>
  <description>MID360 Livox CustomMsg to PointCloud2 with tag / stride / blind / height filtering (replaces livox_custom_to_pointcloud2.py).</description>
  <maintainer email="robot@example.com">G1 team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>livox_ros_driver2</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
