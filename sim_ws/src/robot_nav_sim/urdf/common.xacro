<?xml version="1.0"?>
<!-- 三台机器人共用的部分：Mid-360 雷达 + IMU、关节状态、仿真真值。话题名对三台机器人都一样。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 坐标系名。默认 base_footprint（脚下）/ base_link（躯干），配合本包自带的 Nav2。
       接 Lightning-LM 时改成 root_link:=body_link trunk_link:=trunk：
       Lightning 自己发布 map->base_link->body_link 和 base_link->base_footprint，URDF 里不能再出现这两个名字。 -->
  <xacro:arg name="root_link" default="base_footprint"/>
  <xacro:arg name="trunk_link" default="base_link"/>
  <xacro:property name="root" value="$(arg root_link)"/>
  <xacro:property name="trunk" value="$(arg trunk_link)"/>

  <material name="lidar_black"><color rgba="0.08 0.08 0.09 1"/></material>

  <!--
    Livox Mid-360 近似模型：gpu_lidar，水平 360°（900 点），垂直 -7°~52°（32 线），10 Hz，测距 0.1~40 m。
    真机是非重复扫描，这里用规则扫描近似；对 2D 导航和 3D 建图练习足够。
    内置 IMU 200 Hz，和雷达同一个坐标系（真机有几厘米偏移，这里忽略）。
  -->
  <xacro:macro name="mid360" params="parent xyz rpy:='0 0 0'">
    <joint name="mid360_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="mid360_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <link name="mid360_link">
      <visual>
        <origin xyz="0 0 -0.02" rpy="0 0 0"/>
        <geometry><cylinder radius="0.0325" length="0.06"/></geometry>
        <material name="lidar_black"/>
      </visual>
    </link>
    <gazebo reference="mid360_link">
      <sensor name="mid360" type="gpu_lidar">
        <gz_frame_id>mid360_link</gz_frame_id>
        <topic>/mid360/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>900</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.1222</min_angle>
              <max_angle>0.9076</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
      <sensor name="mid360_imu" type="imu">
        <gz_frame_id>mid360_link</gz_frame_id>
        <topic>/mid360/imu</topic>
        <update_rate>200</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- 关节状态 + 仿真真值（3D 位姿，只用于楼层自动识别和评估，导航本身不用） -->
  <xacro:macro name="common_plugins">
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/robot/joint_states</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>${root}</robot_base_frame>
        <odom_topic>/robot/ground_truth</odom_topic>
        <tf_topic>/robot/ground_truth/tf</tf_topic>
        <dimensions>3</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- 差速驱动：订阅 /robot/cmd_vel，发布轮式里程计 odom -> base_footprint -->
  <xacro:macro name="diff_drive_plugin" params="separation radius max_v:=1.0 max_w:=2.0">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${separation}</wheel_separation>
        <wheel_radius>${radius}</wheel_radius>
        <max_linear_acceleration>1.5</max_linear_acceleration>
        <max_angular_acceleration>3.0</max_angular_acceleration>
        <max_linear_velocity>${max_v}</max_linear_velocity>
        <max_angular_velocity>${max_w}</max_angular_velocity>
        <topic>/robot/cmd_vel</topic>
        <odom_topic>/robot/odom</odom_topic>
        <tf_topic>/robot/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>${root}</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- 四轮滑移转向（Go2 的隐藏底盘用）：四个轮子都驱动，爬坡时前后总有轮子着地 -->
  <xacro:macro name="skid_drive_plugin" params="separation radius max_v:=1.0 max_w:=2.0">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>${separation}</wheel_separation>
        <wheel_radius>${radius}</wheel_radius>
        <max_linear_acceleration>1.5</max_linear_acceleration>
        <max_angular_acceleration>3.0</max_angular_acceleration>
        <max_linear_velocity>${max_v}</max_linear_velocity>
        <max_angular_velocity>${max_w}</max_angular_velocity>
        <topic>/robot/cmd_vel</topic>
        <odom_topic>/robot/odom</odom_topic>
        <tf_topic>/robot/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>${root}</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- 驱动轮：continuous 关节，绕轮轴旋转 -->
  <xacro:macro name="drive_wheel" params="name parent xyz radius width mass:=0.6 visible:=true mu:=1.2">
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="200" velocity="40"/>
    </joint>
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="${mass * (3 * radius * radius + width * width) / 12}" ixy="0" ixz="0"
                 iyy="${mass * (3 * radius * radius + width * width) / 12}" iyz="0"
                 izz="${mass * radius * radius / 2}"/>
      </inertial>
      <xacro:if value="${visible}">
        <visual>
          <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
          <material name="tire"><color rgba="0.12 0.12 0.13 1"/></material>
        </visual>
      </xacro:if>
      <collision>
        <geometry><cylinder radius="${radius}" length="${width}"/></geometry>
      </collision>
    </link>
    <gazebo reference="${name}">
      <mu1>${mu}</mu1>
      <mu2>${mu}</mu2>
    </gazebo>
  </xacro:macro>

  <!-- 万向球：零摩擦球体，单独保留成一个 link 以便设置摩擦 -->
  <xacro:macro name="caster" params="name parent xyz radius visible:=false">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
    <link name="${name}">
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
      <xacro:if value="${visible}">
        <visual>
          <geometry><sphere radius="${radius}"/></geometry>
          <material name="caster_grey"><color rgba="0.5 0.5 0.52 1"/></material>
        </visual>
      </xacro:if>
      <collision>
        <geometry><sphere radius="${radius}"/></geometry>
      </collision>
    </link>
    <gazebo reference="${name}_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference="${name}">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
</robot>
